{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo build --filter @tasa/admin",
    "watchPatterns": ["apps/admin/**", "packages/contracts/**"]
  },
  "deploy": {
    "startCommand": "npx --yes serve@14 -s apps/admin/dist -l ${PORT:-3000}",
    "restartPolicyType": "ON_FAILURE"
  }
}
