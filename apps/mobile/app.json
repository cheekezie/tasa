{
  "expo": {
    "name": "Tasa",
    "slug": "tasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.tasa.app"
    },
    "android": {
      "package": "ng.tasa.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tela-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4",
          "dark": {
            "image": "./assets/images/tela-icon-white.png",
            "backgroundColor": "#0E1311"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      "expo-localization",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tasa uses your photos so you can choose a profile picture, an event poster, or a photo of your ID to sell tickets.",
          "cameraPermission": "Tasa uses your camera so you can take a profile picture, or a photo of yourself and your ID to sell tickets.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Tasa uses the camera to scan tickets at your events.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Tasa saves your tickets to your photos.",
          "photosPermission": "Tasa saves your tickets to your photos."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
