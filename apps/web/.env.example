# Public site URL. Invite links (https://<this>/g/CODE) open the app from this domain.
NEXT_PUBLIC_SITE_URL=https://tasa.ng

# Store listings (the buttons hide until these are set).
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# The Tasa API (one address for everything). The API must list this site's address in its CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4110/api

# Universal Links (iOS): Apple Team ID + bundle identifier.
IOS_APP_ID=ABCDE12345.ng.tasa.app
# App Links (Android): package name and the SHA-256 fingerprints of the signing certificates
# (Play Console > Setup > App signing), comma-separated.
ANDROID_PACKAGE=ng.tasa.app
ANDROID_SHA256_FINGERPRINTS=
