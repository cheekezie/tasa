{
  "name": "tasa-api",
  "version": "0.1.0",
  "private": true,
  "description": "Tasa backend — wallet, SaySwitch funding and bill payments",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "seed:promos": "tsx --env-file-if-exists=.env src/scripts/seed-promos.ts",
    "seed:dev-admins": "tsx --env-file-if-exists=.env src/scripts/seed-dev-admins.ts",
    "migrate:group-dues": "tsx --env-file-if-exists=.env src/scripts/migrate-group-dues.ts",
    "db:local": "mkdir -p .data/db && mongod --replSet rs0 --dbpath .data/db --port 27018 --bind_ip 127.0.0.1",
    "migrate:tasa-rename": "tsx --env-file-if-exists=.env src/scripts/migrate-tasa-rename.ts",
    "seed:schools": "tsx --env-file-if-exists=.env src/scripts/seed-schools.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@smithy/fetch-http-handler": "^5.8.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.7.0",
    "mongoose": "^8.18.0",
    "pino-pretty": "^13.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "mongodb-memory-server": "^10.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
