# Must be set explicitly: `development` turns on the fixed OTP below.
NODE_ENV=development
PORT=4110

# Must be a replica set (wallet movements use Mongo transactions). Locally: see the README's
# `npm run db:local`, on its own port so it can't clash with another mongod. Atlas works as-is.
MONGODB_URI=mongodb://127.0.0.1:27018/tasa-app?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# Browser origins only (Expo web, admin). Native app requests aren't affected.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -hex 32
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# SaySwitch — wallet funding. sk_test_/pk_test_ keys run against their sandbox on the same host.
SAYSWITCH_BASE_URL=https://backendapi.sayswitchgroup.com
SAYSWITCH_SECRET_KEY=
SAYSWITCH_PUBLIC_KEY=
# Optional: settle funding transfers into a named NGN wallet instead of the default one.
# Users without an email are sent to SaySwitch as <userId>@<domain>. Use a domain you own.
CUSTOMER_EMAIL_DOMAIN=customers.tasa.ng

# VTpass — bill payments. Keys from vtpass.com/account → API Keys (sandbox.vtpass.com/account for test).
# Live: https://vtpass.com/api. Point VTpass's transaction-update webhook at
# https://<host>/api/webhooks/vtpass and whitelist the server IP / products on your VTpass account.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

FUNDING_ACCOUNT_TTL_MINUTES=30
QUOTE_TTL_MINUTES=15

# Without a key, OTPs print to the console (refused in production).
TERMII_API_KEY=
TERMII_SENDER_ID=Tasa
# Email OTPs, for users whose SMS doesn't arrive. Without a token, emails print to the console.
ZEPTOMAIL_TOKEN=
EMAIL_FROM_ADDRESS=noreply@tasa.ng
# The public website, for links in emails to website orders.
SITE_URL=https://tasa.ng
EMAIL_FROM_NAME=Tasa
# Sent to VTpass as the customer phone for users who signed up by email and have no phone yet.
BUSINESS_PHONE=
EXPO_ACCESS_TOKEN=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


# Profile photos. The bucket stays private; leave the keys empty on a host with an IAM role.
S3_BUCKET=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Every OTP flow accepts this in development, and nothing is sent. Never set it in production:
# the server refuses to start.
DEV_OTP_CODE=123456
