{
  "name": "@tasa/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared by the API and every client: enums, money (kobo), the response envelope. Ships TypeScript source — no build step.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
