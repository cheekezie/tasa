    "./enums": "./src/enums.ts",
    "./money": "./src/money.ts"
  },
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": {
    "@tasa/config": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
